# Origen del API. "/api" (o "/") = mismo origen: en desarrollo Vite reenvía /api al API de :5055
# (vite.config.ts), en IIS la web y el API comparten clinic.example.com. Un origen completo solo si el
# API vive en otro dominio.
VITE_API_URL=/api

# Nombre de respaldo mientras carga la marca del canal (GET /api/v1/branding)
VITE_APP_NAME=NemediClinic

# Solo desarrollo: fuerza la marca de otro canal sin tocar el archivo hosts.
# VITE_BRANDING_HOST=canal-demo.example.com
